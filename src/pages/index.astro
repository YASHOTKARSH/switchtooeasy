---
import MainLayout from "../layouts/MainLayout.astro";
import TemplateCard from "../components/TemplateCard.astro";
import PromptCard from "../components/PromptCard.astro";

import { templates } from "../data/templates";
import { prompts } from "../data/prompts";
import { blogs } from "../data/blogs";
import ReviewsSection from "../components/ReviewsSection.astro";
import ReviewPopup from "../components/ReviewPopup.astro";

const trendingTemplates = [...templates].reverse().slice(0, 4);
const trendingPrompts = [...prompts].reverse().slice(0, 3);
const recentBlogs = [...blogs].reverse().slice(0, 3);

const categories = [
  { name: "Love Edits", slug: "love-edits", count: "45+ Templates" },
  { name: "Attitude Reels", slug: "attitude-reels", count: "38+ Templates" },
  { name: "Birthday Videos", slug: "birthday-videos", count: "30+ Templates" },
  { name: "Cinematic Photos", slug: "cinematic-photos", count: "50+ Prompts" },
  { name: "Instagram Reels", slug: "instagram-reels", count: "65+ Templates" },
  { name: "AI Portraits", slug: "ai-portraits", count: "40+ Prompts" },
];
---

<MainLayout
  title="SwitchTooEasy - Viral VN Templates & AI Image Prompts for Creators"
  description="Discover trending VN templates, cinematic AI image prompts, reels demo videos and professional editing resources designed to make your Instagram reels go viral."
  canonical="https://switchtooeasy.netlify.app/"
>
  <!-- HERO SECTION -->
  <header class="relative overflow-hidden px-5 pb-24 pt-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,#7c3aed44,transparent_35%),radial-gradient(circle_at_bottom_right,#ec489944,transparent_30%)]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-purple-400/30 bg-purple-400/10 px-4 py-2 text-sm font-medium text-purple-200 backdrop-blur-md">
          <span class="flex h-2 w-2 rounded-full bg-purple-400 animate-pulse"></span>
          Trusted by 50,000+ Instagram Creators & Editors
        </div>

        <h1 class="mt-7 text-5xl font-black tracking-tight leading-tight text-white md:text-7xl">
          Create viral reels using VN templates and AI prompts.
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/70">
          SwitchTooEasy helps creators discover trending VN templates, cinematic AI image prompts, and high-engagement reels preview videos for Instagram, YouTube Shorts, and short-form video storytelling.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href="/templates"
            class="group inline-flex items-center justify-center rounded-full bg-purple-600 px-8 py-4 text-center font-bold text-white shadow-lg shadow-purple-600/30 transition-all duration-200 hover:bg-purple-500 hover:shadow-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-black"
          >
            <span>Explore Viral Templates</span>
            <svg class="ml-2 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/prompts"
            class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 py-4 text-center font-bold text-white backdrop-blur-md transition-all duration-200 hover:bg-white/10 hover:border-white/25 focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-black"
          >
            Browse AI Prompts
          </a>
        </div>

        <!-- Quick Proof Metrics Bar -->
        <div class="mt-16 grid grid-cols-2 gap-4 border-t border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <p class="text-2xl font-extrabold text-white">100%</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Free Access</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-white">1-Click</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Instant Setup</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-white">Daily</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">New Additions</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-white">VN & CapCut</p>
            <p class="mt-1 text-xs text-white/50 uppercase tracking-wider">Fully Compatible</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT CONTAINER -->
  <main id="main-content" class="space-y-24 pb-16">

    <!-- TRENDING TEMPLATES -->
    <section class="px-5" aria-labelledby="trending-templates-heading">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-purple-400">🔥 Trending Today</span>
            <h2 id="trending-templates-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
              Popular VN templates for viral reels.
            </h2>
            <p class="mt-2 text-sm text-white/60">Handpicked viral templates ready to download and edit in seconds.</p>
          </div>

          <a href="/templates" class="inline-flex items-center text-sm font-semibold text-purple-300 transition-colors hover:text-purple-200">
            <span>View All Templates</span>
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {trendingTemplates.map((template) => (
            <TemplateCard template={template} />
          ))}
        </div>
      </div>
    </section>

    <!-- CREATOR DISCOVERY BANNER (Interactive Habit Formation) -->
    <section class="px-5" aria-label="Creator Discovery Callout">
      <div class="mx-auto max-w-7xl">
        <div class="relative overflow-hidden rounded-3xl border border-purple-500/20 bg-gradient-to-r from-purple-900/40 via-purple-900/20 to-black p-8 sm:p-12 backdrop-blur-xl">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-500/10 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="relative z-10 grid gap-6 md:grid-cols-3 md:items-center">
            <div class="md:col-span-2">
              <span class="inline-flex items-center rounded-full bg-purple-500/20 px-3 py-1 text-xs font-semibold text-purple-300">Creator Workflow</span>
              <h2 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">Stop wasting hours searching for editing links.</h2>
              <p class="mt-2 text-sm leading-relaxed text-white/70">
                Bookmark SwitchTooEasy to access verified QR codes, instant Drive direct downloads, and bulletproof step-by-step guides for every trending Instagram audio.
              </p>
            </div>
            <div class="flex justify-start md:justify-end">
              <a
                href="/templates"
                class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-center text-sm font-bold text-black shadow-lg transition-all duration-200 hover:bg-white/95 hover:scale-105"
              >
                Start Editing Now &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRENDING AI PROMPTS -->
    <section class="px-5" aria-labelledby="trending-prompts-heading">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-pink-400">✨ AI Generation</span>
            <h2 id="trending-prompts-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
              Realistic prompts for viral image generation.
            </h2>
            <p class="mt-2 text-sm text-white/60">Copy high-converting prompts for Midjourney, DALL-E, and Stable Diffusion.</p>
          </div>

          <a href="/prompts" class="inline-flex items-center text-sm font-semibold text-pink-300 transition-colors hover:text-pink-200">
            <span>View All Prompts</span>
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {trendingPrompts.map((prompt) => (
            <PromptCard prompt={prompt} />
          ))}
        </div>
      </div>
    </section>

    <!-- CATEGORIES EXPLORATION -->
    <section class="px-5" aria-labelledby="categories-heading">
      <div class="mx-auto max-w-7xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-purple-400">📂 Content Library</span>
        <h2 id="categories-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
          Explore editing styles and content ideas.
        </h2>
        <p class="mt-2 text-sm text-white/60">Find specialized resources categorized by mood, genre, and platform.</p>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <a
              href="/templates"
              class="group relative overflow-hidden rounded-3xl border border-white/15 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-purple-500/50 hover:bg-white/10 hover:shadow-xl hover:shadow-purple-950/20"
            >
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">{category.name}</h3>
                <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/70">{category.count}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-white/60">
                Discover trending templates, reels ideas and AI editing prompts optimized for {category.name.toLowerCase()}.
              </p>
              <div class="mt-6 flex items-center text-sm font-semibold text-purple-400 group-hover:text-purple-300">
                <span>Explore category</span>
                <svg class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- RECENT BLOGS & EDITING GUIDES -->
    <section class="px-5" aria-labelledby="latest-guides-heading">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="inline-block text-xs font-bold uppercase tracking-widest text-purple-400">📚 Creator Academy</span>
            <h2 id="latest-guides-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
              Learn editing, prompts and viral content ideas.
            </h2>
            <p class="mt-2 text-sm text-white/60">Expert tips to grow your reach and master modern mobile video production.</p>
          </div>

          <a href="/blog" class="inline-flex items-center text-sm font-semibold text-purple-300 transition-colors hover:text-purple-200">
            <span>View All Guides</span>
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recentBlogs.map((blog) => (
            <article class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm transition-all duration-300 hover:border-white/25 hover:bg-white/10">
              <a href={`/blog/${blog.slug}`} class="absolute inset-0 z-10" aria-label={`Read guide: ${blog.title}`}></a>
              <figure class="relative aspect-video w-full overflow-hidden bg-black">
                <img
                  src={blog.image}
                  alt={blog.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 z-20">
                  <span class="rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
                    {blog.category}
                  </span>
                </div>
              </figure>

              <div class="flex flex-col flex-grow p-6">
                <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors leading-snug">
                  {blog.title}
                </h3>

                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-white/60">
                  {blog.excerpt}
                </p>

                <div class="mt-6 flex items-center text-sm font-semibold text-purple-400 group-hover:text-purple-300">
                  <span>Read Guide</span>
                  <svg class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- WHY SWITCHTOOEASY (Value Propositional Trust Section) -->
    <section class="px-5" aria-labelledby="why-us-heading">
      <div class="mx-auto max-w-7xl rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12 backdrop-blur-md">
        <div class="max-w-3xl">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-purple-400">⚡ Platform Benefits</span>
          <h2 id="why-us-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
            Built for creators who want fast and professional-looking edits.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-white/70">
            SwitchTooEasy combines verified VN templates, AI image prompts and reels previews in one centralized hub. Instead of hunting across fragmented social media links, creators can instantly find high-converting assets and ship viral videos faster.
          </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-black/40 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-white">Lightning Fast Setup</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">
              Pre-configured VN project links and clear QR codes reduce your editing workflow to minutes.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/40 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-white">Viral AI Prompts</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">
              Copy meticulously engineered text prompts to produce stunning, realistic cinematic portraits instantly.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/40 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold text-white">Reels Preview Hub</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">
              Watch full demo videos and preview transitions before committing your media to a project.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FREQUENTLY ASKED QUESTIONS (SEO Rich Content) -->
    <section class="px-5" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-4xl">
        <div class="text-center">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-purple-400">❓ Common Questions</span>
          <h2 id="faq-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
            Everything you need to know about our templates.
          </h2>
        </div>

        <div class="mt-10 space-y-4">
          <details class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between text-lg font-bold text-white">
              <span>What are VN templates and how do they work?</span>
              <span class="ml-6 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 transition-transform group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-white/60">
              VN templates are pre-structured video editing projects created for the VN Video Editor app. They contain preset transitions, beat sync points, effects, and text layers. Creators simply plug in their own clips and photos to generate professional-grade Instagram reels and shorts instantly.
            </p>
          </details>

          <details class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between text-lg font-bold text-white">
              <span>Are these templates 100% free to download?</span>
              <span class="ml-6 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 transition-transform group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-white/60">
              Yes! All VN templates and AI image prompts listed on SwitchTooEasy are completely free to use for personal and professional content creation across Instagram, YouTube, TikTok, and other platforms.
            </p>
          </details>

          <details class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between text-lg font-bold text-white">
              <span>How do AI image prompts help content creators?</span>
              <span class="ml-6 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 transition-transform group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-white/60">
              AI image prompts are detailed syntax formulas designed for generators like Midjourney or DALL-E. Creators use them to produce high-end cinematic portraits, aesthetic backgrounds, and unique visual assets for video thumbnails and social media carousel posts.
            </p>
          </details>

          <details class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between text-lg font-bold text-white">
              <span>Do I need advanced editing skills to use SwitchTooEasy?</span>
              <span class="ml-6 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 transition-transform group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-white/60">
              Not at all. Every template comes with a comprehensive step-by-step guide explaining how to scan the QR code, import files via mobile storage, and export crisp, high-definition videos with zero prior editing experience required.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- EMOTIONAL CONVERSION CTA -->
    <section class="px-5">
      <div class="mx-auto max-w-7xl">
        <div class="relative overflow-hidden rounded-3xl border border-purple-500/20 bg-gradient-to-br from-purple-900/60 via-purple-950/40 to-black p-8 sm:p-16 text-center backdrop-blur-xl shadow-2xl">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-purple-500/15 via-transparent to-transparent" aria-hidden="true"></div>
          
          <h2 class="relative z-10 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
            Start creating viral content today.
          </h2>

          <p class="relative z-10 mx-auto mt-4 max-w-xl text-base text-white/70 sm:text-lg">
            Join thousands of creators upgrading their Instagram reels and short-form video workflow with our free templates.
          </p>

          <div class="relative z-10 mt-8 flex flex-col justify-center gap-4 sm:flex-row">
            <a
              href="/templates"
              class="inline-flex items-center justify-center rounded-full bg-purple-600 px-8 py-4 text-center font-bold text-white shadow-lg shadow-purple-600/30 transition-all duration-200 hover:bg-purple-500 hover:shadow-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-black"
            >
              Browse VN Templates
            </a>

            <a
              href="/prompts"
              class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 py-4 text-center font-bold text-white backdrop-blur-md transition-all duration-200 hover:bg-white/10 hover:border-white/25 focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-black"
            >
              Explore AI Prompts
            </a>
          </div>
        </div>
      </div>
    </section>
    <!-- CREATOR TESTIMONIALS -->
    <ReviewsSection />

  </main>
</MainLayout>