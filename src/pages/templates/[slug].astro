---
import MainLayout from "../../layouts/MainLayout.astro";
import StructuredData from "../../components/StructuredData.astro";
import ReviewPopup from "../../components/ReviewPopup.astro";
import { templates } from "../../data/templates";

export function getStaticPaths() {
  return templates.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

const { template } = Astro.props;

// Filter related templates (exclude current, take up to 3)
const relatedTemplates = templates
  .filter((t) => t.slug !== template.slug)
  .slice(0, 3);
---

<MainLayout
  title={`${template.title} - Download VN Template | SwitchTooEasy`}
  description={template.shortDescription || template.description}
  canonical={`https://switchtooeasy.netlify.app/templates/${template.slug}`}
  image={`https://switchtooeasy.netlify.app${template.image}`}
  type="article"
>
  <StructuredData
    type="CreativeWork"
    title={template.title}
    description={template.description}
    url={`https://switchtooeasy.netlify.app/templates/${template.slug}`}
    image={`https://switchtooeasy.netlify.app${template.image}`}
  />

  <main id="main-content" class="relative overflow-hidden pb-24 lg:pb-16">
    <!-- SECTION 1: Premium Hero -->
    <header class="px-5 pt-10 lg:pt-16">
      <div class="mx-auto grid max-w-7xl items-start gap-10 lg:grid-cols-2 lg:gap-16">
        
        <!-- Left: Video Preview -->
        <figure class="mx-auto w-full max-w-sm lg:max-w-md">
          <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-2xl shadow-purple-950/20">
            <div class="absolute inset-0 animate-pulse bg-gradient-to-br from-white/10 via-white/5 to-white/15" aria-hidden="true"></div>
            <video
              src={template.video}
              poster={template.image}
              controls
              muted
              autoplay
              playsinline
              preload="metadata"
              class="relative aspect-[9/16] w-full bg-black object-cover"
              onloadeddata="this.previousElementSibling.style.display='none'"
              aria-label={`Video preview for ${template.title}`}
            ></video>
          </div>
        </figure>

        <!-- Right: Details & CTAs -->
        <div class="flex flex-col">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center rounded-full bg-purple-500/15 px-4 py-1.5 text-xs font-semibold tracking-wide text-purple-300 ring-1 ring-inset ring-purple-500/30">
              {template.category}
            </span>
            <span class="inline-flex items-center rounded-full bg-white/5 px-4 py-1.5 text-xs font-medium text-white/70 ring-1 ring-inset ring-white/10">
              VN Supported
            </span>
          </div>

          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
            {template.title}
          </h1>

          <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
            {template.shortDescription || template.description}
          </p>

          {template.tags && template.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2" aria-label="Template tags">
              {template.tags.map((tag) => (
                <span class="inline-flex items-center rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-white/60 transition-colors hover:bg-white/10">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <!-- Primary & Secondary Action Buttons -->
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={template.qrCode}
              download={`${template.slug}-vn-qr.png`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-purple-600 px-8 py-4 text-center text-base font-semibold text-white shadow-lg shadow-purple-600/30 transition-all duration-200 hover:bg-purple-500 hover:shadow-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-black"
              aria-label={`Download QR code for ${template.title} VN Template`}
            >
              <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
              Use This Template
            </a>

            <a
              href="/templates"
              class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-8 py-4 text-center text-base font-semibold text-white transition-all duration-200 hover:bg-white/10 hover:border-white/25 focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-black"
            >
              Back to Templates
            </a>
          </div>

          <!-- REVIEW POPUP INTEGRATION -->
          <div class="mt-6">
            <ReviewPopup template={template.title} />
          </div>

          <!-- Desktop QR Code Card (if exists) -->
          {template.qrCode && (
            <div class="mt-10 hidden rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-md lg:block">
              <div class="flex items-center gap-6">
                <a
                  href={template.qrCode}
                  download={`${template.slug}-vn-qr.png`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative block shrink-0 cursor-pointer transition-transform hover:scale-105"
                  aria-label="Download QR code image"
                >
                  <img
                    src={template.qrCode}
                    alt={`${template.title} QR Code for VN app`}
                    class="h-32 w-32 rounded-2xl border border-white/10 bg-white p-2.5 object-contain shadow-inner"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 flex items-center justify-center rounded-2xl bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
                    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                  </div>
                </a>
                <div>
                  <h2 class="text-xl font-bold text-white">VN App QR Code</h2>
                  <p class="mt-2 text-sm leading-relaxed text-white/60">
                    Click the button or QR image to download this QR code, then scan it inside the VN app to use the template.
                  </p>
                </div>
              </div>
            </div>
          )}

        </div>
      </div>
    </header>

    <!-- SECTION 2: Template Highlights -->
    <section class="mx-auto mt-16 max-w-7xl px-5" aria-label="Template Highlights">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">Category</h2>
              <p class="text-base font-bold text-white">{template.category}</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">Compatibility</h2>
              <p class="text-base font-bold text-white">Works on Mobile</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            </div>
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">Editor Platform</h2>
              <p class="text-base font-bold text-white">VN App Supported</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Mobile QR Code Card (Visible on mobile if qrCode exists) -->
    {template.qrCode && (
      <section class="mx-auto mt-12 max-w-7xl px-5 lg:hidden" aria-label="QR Code Scanner">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-md">
          <div class="flex flex-col items-center text-center sm:flex-row sm:text-left sm:gap-6">
            <a
              href={template.qrCode}
              download={`${template.slug}-vn-qr.png`}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block shrink-0 cursor-pointer active:scale-95"
              aria-label="Download QR code image"
            >
              <img
                src={template.qrCode}
                alt={`${template.title} QR Code`}
                class="w-36 rounded-2xl border border-white/10 bg-white p-3 shadow-inner"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center rounded-2xl bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              </div>
            </a>
            <div class="mt-4 sm:mt-0">
              <h2 class="text-xl font-bold text-white">VN App QR Code</h2>
              <p class="mt-2 text-sm leading-relaxed text-white/60">
                Tap the QR image to download it to your device and use it inside the VN application.
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- SECTION 4: How To Use (Step-by-Step Guide with Timeline UI) -->
    <section class="mx-auto mt-20 max-w-7xl px-5">
      <div class="text-center">
        <h2 class="text-xs font-bold uppercase tracking-widest text-purple-400">Step-by-Step Guide</h2>
        <p class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">How to Use This Template</p>
        <p class="mt-3 text-base text-white/60">Follow these simple steps to bring your masterpiece to life.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Step 1 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">01</span>
            <span class="text-xs font-medium text-white/40">Step 1 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-1.webp" alt="Step 1: Download QR code" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Download QR Code</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Sabse pehle upar diye gaye button ya QR code par click karke QR code image ko apne device mein download karo.</p>
        </article>

        <!-- Step 2 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">02</span>
            <span class="text-xs font-medium text-white/40">Step 2 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-2.webp" alt="Step 2: Open VN app scanner" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Open VN Scanner</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">VN App open karke right top corner mein jo scanner icon aayega, uspe click karo.</p>
        </article>

        <!-- Step 3 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">03</span>
            <span class="text-xs font-medium text-white/40">Step 3 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-3.webp" alt="Step 3: Select QR image" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Select QR Image</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Apni gallery se wahi download ki hui QR code wali image select karo.</p>
        </article>

        <!-- Step 4 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">04</span>
            <span class="text-xs font-medium text-white/40">Step 4 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-4.webp" alt="Step 4: Click template download in VN" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Download in VN App</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Phir VN app mein template download ka option aayega, uspe click karo.</p>
        </article>

        <!-- Step 5 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">05</span>
            <span class="text-xs font-medium text-white/40">Step 5 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-5.webp" alt="Step 5: Open drive and download icon" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Drive Download Icon</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Phir Drive open hogi, usme top par download icon show hoga.</p>
        </article>

        <!-- Step 6 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">06</span>
            <span class="text-xs font-medium text-white/40">Step 6 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-square">
            <img src="/images/how-to/step-6.webp" alt="Step 6: Click download anyway" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Download Anyway</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Uske baad 'Download Anyway' par click karo.</p>
        </article>

        <!-- Step 7 -->
        <article class="flex flex-col rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20 md:col-span-2 lg:col-span-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/20 text-sm font-bold text-purple-300">07</span>
            <span class="text-xs font-medium text-white/40">Step 7 of 7</span>
          </div>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/40 aspect-[21/9]">
            <img src="/images/how-to/step-7.webp" alt="Step 7: Template and timeline open" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
          </figure>
          <h3 class="mt-6 text-lg font-bold text-white">Open Timeline & Edit</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">Finally, template aur timeline open ho jayegi jisme aap apni clips add karke editing start kar sakte ho!</p>
        </article>
      </div>
    </section>

    <!-- SECTION 5: Template Description -->
    <section class="mx-auto mt-20 max-w-4xl px-5">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-12 backdrop-blur-sm">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">About This Template</h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-white/70">
          <p>{template.description}</p>
        </div>
      </div>
    </section>

    <!-- SECTION 6: Related Templates -->
    {relatedTemplates.length > 0 && (
      <section class="mx-auto mt-20 max-w-7xl px-5" aria-label="Related Templates">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <h2 class="text-xs font-bold uppercase tracking-widest text-purple-400">Discover More</h2>
            <p class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Related VN Templates</p>
          </div>
          <a href="/templates" class="text-sm font-semibold text-purple-400 transition-colors hover:text-purple-300">
            View all templates &rarr;
          </a>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedTemplates.map((relTemplate) => (
            <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/5 transition-all duration-300 hover:border-white/20 hover:bg-white/10">
              <a href={`/templates/${relTemplate.slug}`} class="absolute inset-0 z-10" aria-label={`View ${relTemplate.title}`}></a>
              <figure class="relative aspect-[9/16] w-full overflow-hidden bg-black">
                <img
                  src={relTemplate.image}
                  alt={relTemplate.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 z-20">
                  <span class="rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white backdrop-blur-md">
                    {relTemplate.category}
                  </span>
                </div>
              </figure>
              <div class="flex flex-col flex-grow p-6">
                <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
                  {relTemplate.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm text-white/60">
                  {relTemplate.shortDescription || relTemplate.description}
                </p>
                <div class="mt-6 flex items-center text-sm font-semibold text-purple-400 group-hover:text-purple-300">
                  Use Template &rarr;
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- SECTION 7: Call to Action (Explore More) -->
    <section class="mx-auto mt-20 max-w-7xl px-5">
      <div class="relative overflow-hidden rounded-3xl border border-purple-500/20 bg-gradient-to-r from-purple-900/40 via-purple-900/20 to-black p-8 sm:p-14 text-center backdrop-blur-xl">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-500/10 via-transparent to-transparent" aria-hidden="true"></div>
        <h2 class="relative z-10 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Explore More VN Templates
        </h2>
        <p class="relative z-10 mx-auto mt-3 max-w-xl text-base text-white/70">
          Discover hundreds of trending aesthetic, cinematic, and viral video templates updated daily.
        </p>
        <div class="relative z-10 mt-8">
          <a
            href="/templates"
            class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-center text-base font-semibold text-black shadow-lg transition-all duration-200 hover:bg-white/90 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black"
          >
            Browse All Templates
          </a>
        </div>
      </div>
    </section>

    <!-- DYNAMIC CLIENT-SIDE REVIEWS SECTION (Lightning Fast & Non-Blocking) -->
    <section class="mx-auto mt-20 max-w-7xl px-5" id="reviews-section">
      <div class="text-center">
        <span class="inline-flex items-center rounded-full bg-purple-500/15 px-3 py-1 text-xs font-semibold text-purple-300 ring-1 ring-inset ring-purple-500/30">
          Creator Testimonials
        </span>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Loved by thousands of creators.
        </h2>
        <p class="mt-2 text-sm text-white/60">See what editors are saying about our VN templates.</p>
      </div>

      <!-- Loading State Placeholder -->
      <div id="reviews-loading" class="mt-12 text-center text-white/50 text-sm animate-pulse">
        Loading creator reviews...
      </div>

      <!-- Reviews Grid Container -->
      <div id="reviews-grid" class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 hidden"></div>

      <!-- Empty State -->
      <div id="reviews-empty" class="mt-12 rounded-3xl border border-white/10 bg-white/5 p-12 text-center hidden">
        <p class="text-sm text-white/60">No approved reviews yet. Be the first to leave one using the button above!</p>
      </div>
    </section>
  </main>

  <!-- MOBILE UX: Sticky Download Bar at Bottom -->
  <nav class="fixed inset-x-0 bottom-0 z-50 p-4 backdrop-blur-xl bg-black/80 border-t border-white/10 lg:hidden shadow-2xl" aria-label="Mobile Bottom Navigation">
    <div class="mx-auto flex max-w-md items-center gap-3">
      <a
        href={template.qrCode}
        download={`${template.slug}-vn-qr.png`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center rounded-full bg-purple-600 px-6 py-3.5 text-center text-sm font-bold text-white shadow-lg shadow-purple-600/30 active:scale-95 transition-transform"
        aria-label={`Download QR code for ${template.title} VN Template`}
      >
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        Use Template
      </a>
      <a
        href="/templates"
        class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-5 py-3.5 text-center text-sm font-semibold text-white active:scale-95 transition-transform"
      >
        More
      </a>
    </div>
  </nav>

  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      const grid = document.getElementById("reviews-grid");
      const loading = document.getElementById("reviews-loading");
      const empty = document.getElementById("reviews-empty");
      const scriptUrl = "https://script.google.com/macros/s/AKfycbxJZLXQJFGFS0uu5TTMqXo31HMxYRRQPTOrZrUKtrKFXmRy8LBpX1nSTfMql2KG7807AA/exec";

      try {
        const res = await fetch(scriptUrl);
        const reviews = await res.json();

        loading?.classList.add("hidden");

        if (Array.isArray(reviews) && reviews.length > 0) {
          grid?.classList.remove("hidden");
          if (grid) {
            grid.innerHTML = reviews.map((rev) => `
              <div class="flex flex-col justify-between rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
                <div>
                  <div class="flex items-center gap-1 text-amber-400 text-sm">
                    ${"★".repeat(Number(rev.rating) || 5)}
                  </div>
                  <p class="mt-4 text-sm leading-relaxed text-white/80">
                    "${rev.review}"
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4">
                  <div>
                    <p class="text-sm font-bold text-white">${rev.name}</p>
                    ${rev.instagram ? `<p class="text-xs text-purple-400">@${rev.instagram}</p>` : ''}
                  </div>
                  <span class="rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-medium text-white/60">
                    ${rev.template}
                  </span>
                </div>
              </div>
            `).join('');
          }
        } else {
          empty?.classList.remove("hidden");
        }
      } catch (err) {
        loading?.classList.add("hidden");
        empty?.classList.remove("hidden");
      }
    });
  </script>
</MainLayout>