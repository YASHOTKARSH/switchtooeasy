---
import MainLayout from "../layouts/MainLayout.astro";
import { blogs } from "../data/blogs";
---

<MainLayout
  title="Blog - SwitchTooEasy"
  description="Learn about VN templates, AI prompts, Instagram reels and content creation."
  canonical="https://switchtooeasy.netlify.app/blog"
>
  <section class="px-5 py-20">
    <div class="mx-auto max-w-7xl">
      <h1 class="text-5xl font-black">
        Blog
      </h1>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {blogs.map((blog) => (
          <a
            href={`/blog/${blog.slug}`}
            class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 transition hover:bg-white/10"
          >
            <img
              src={blog.image}
              alt={blog.title}
              class="aspect-video w-full object-cover"
            />

            <div class="p-6">
              <h2 class="text-2xl font-bold">
                {blog.title}
              </h2>

              <p class="mt-4 text-white/60">
                {blog.excerpt}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>