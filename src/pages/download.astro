---
import MainLayout from "../layouts/MainLayout.astro";
import StructuredData from "../components/StructuredData.astro";
---

<MainLayout
  title="Download SwitchTooEasy App - VN Templates & AI Prompts"
  description="Install SwitchTooEasy as a native app for instant access to viral VN templates, AI prompts, and creator resources."
  canonical="https://switchtooeasy.netlify.app/download"
>
  <StructuredData
    type="WebPage"
    title="Download SwitchTooEasy App"
    description="Install SwitchTooEasy as a native Android app."
    url="https://switchtooeasy.netlify.app/download"
  />

  <main id="main-content" class="relative min-h-screen overflow-hidden px-4 py-12 pb-32 md:py-20 lg:px-8">
    <!-- Premium Background Effects -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-purple-600/20 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[300px] bg-pink-600/10 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-2xl mt-8">
      
      <!-- App Store Style Header -->
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8 bg-white/5 border border-white/10 p-6 md:p-8 rounded-[2rem] backdrop-blur-xl shadow-2xl">
        
        <!-- App Icon -->
        <div class="relative shrink-0">
          <div class="absolute inset-0 bg-gradient-to-tr from-purple-600 to-pink-500 blur-xl opacity-50 rounded-[2rem]"></div>
          <div class="relative flex h-28 w-28 md:h-36 md:w-36 items-center justify-center rounded-[2rem] bg-gradient-to-br from-gray-900 to-black border border-white/20 p-4 shadow-xl">
            <img src="/favicon.png" alt="SwitchTooEasy App Icon" class="h-full w-full object-contain drop-shadow-md" />
          </div>
        </div>

        <!-- App Info -->
        <div class="flex-1 text-center md:text-left space-y-2">
          <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight">
            SwitchTooEasy
          </h1>
          <p class="text-lg font-medium text-purple-400">Creator Hub & Templates</p>
          
          <!-- Ratings & Stats -->
          <div class="flex items-center justify-center md:justify-start gap-4 mt-3 text-sm text-white/60">
            <div class="flex flex-col items-center md:items-start">
              <div class="flex items-center text-yellow-500 font-bold text-base gap-1">
                4.9 <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="text-[10px] uppercase tracking-wider">10K+ Ratings</span>
            </div>
            <div class="w-px h-8 bg-white/20"></div>
            <div class="flex flex-col items-center md:items-start">
              <span class="font-bold text-white text-base">Free</span>
              <span class="text-[10px] uppercase tracking-wider">Category: Video</span>
            </div>
          </div>

          <!-- The Install Button (Updated to direct link) -->
          <a
            href="/SwitchTooEasy.apk"
            download="SwitchTooEasy.apk"
            id="pwa-install-btn"
            class="mt-6 flex w-full md:w-auto items-center justify-center gap-2 rounded-full bg-white px-8 py-3.5 text-base font-bold text-black transition-all duration-300 hover:bg-gray-200 active:scale-95 shadow-[0_0_20px_rgba(255,255,255,0.3)] disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span id="btn-text">Download APK</span>
          </a>
          
          <p id="install-status-msg" class="text-xs text-green-400 mt-2 hidden font-medium">Downloading APK...</p>
        </div>
      </div>

      <!-- App Features Preview -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
          <div class="text-2xl mb-2">🎬</div>
          <h3 class="text-white font-bold text-sm">VN Templates</h3>
          <p class="text-white/50 text-xs mt-1">1-click edit</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
          <div class="text-2xl mb-2">🤖</div>
          <h3 class="text-white font-bold text-sm">AI Prompts</h3>
          <p class="text-white/50 text-xs mt-1">Viral images</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
          <div class="text-2xl mb-2">⚡</div>
          <h3 class="text-white font-bold text-sm">Fast UI</h3>
          <p class="text-white/50 text-xs mt-1">No lag</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
          <div class="text-2xl mb-2">📱</div>
          <h3 class="text-white font-bold text-sm">App Shell</h3>
          <p class="text-white/50 text-xs mt-1">Native feel</p>
        </div>
      </div>
    </div>
  </main>

  <!-- iOS Specific Instruction Modal (Popup) -->
  <div id="ios-instruction-modal" class="fixed inset-0 z-[60] hidden items-end sm:items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity opacity-0 pointer-events-none p-4">
    <div class="relative w-full max-w-sm rounded-[2rem] border border-white/10 bg-[#1c1c1e] p-6 text-center shadow-2xl transform translate-y-full transition-transform duration-300" id="ios-modal-content">
      
      <button type="button" id="close-ios-modal" class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white/70 hover:bg-white/20 hover:text-white cursor-pointer">
        ✕
      </button>

      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-500/10 text-blue-500 mb-4">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
      </div>

      <h3 class="text-xl font-bold text-white">Install on iOS</h3>
      <p class="mt-2 text-sm text-white/70">Apple requires a quick manual step to install web apps.</p>
      
      <div class="mt-6 space-y-3 text-left">
        <div class="flex items-center gap-4 rounded-xl bg-white/5 p-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-500 text-xs font-bold text-white">1</span>
          <p class="text-sm text-white/80">Tap the <strong class="text-white">Share</strong> icon below.</p>
        </div>
        <div class="flex items-center gap-4 rounded-xl bg-white/5 p-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-500 text-xs font-bold text-white">2</span>
          <p class="text-sm text-white/80">Scroll and tap <strong class="text-white">Add to Home Screen</strong> <span class="text-lg leading-none">+</span>.</p>
        </div>
      </div>
      
      <p class="mt-6 text-xs text-white/50 animate-bounce">↓ Look at the bottom of your screen ↓</p>
    </div>
  </div>
</MainLayout>

<script>
  const installBtn = document.getElementById("pwa-install-btn");
  const btnText = document.getElementById("btn-text");
  const statusMsg = document.getElementById("install-status-msg");
  
  const iosModal = document.getElementById("ios-instruction-modal");
  const iosModalContent = document.getElementById("ios-modal-content");
  const closeIosBtn = document.getElementById("close-ios-modal");

  // Device & State Detection
  const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone;

  // Initialize UI based on state
  function updateUIForInstalledState() {
    if (btnText) btnText.innerText = "App Installed";
    if (installBtn) {
      installBtn.classList.add("opacity-50", "cursor-not-allowed", "bg-green-500", "text-white");
      installBtn.classList.remove("hover:bg-gray-200", "bg-white", "text-black");
      installBtn.removeAttribute("href"); // Disable download if already installed
    }
  }

  if (isStandalone) {
    updateUIForInstalledState();
  } else if (isIos && btnText) {
    btnText.innerText = "Install (iOS)";
  }

  // Handle Button Click
  if (installBtn) {
    installBtn.addEventListener("click", (e) => {
      if (isStandalone) {
        e.preventDefault();
        return;
      }

      if (isIos) {
        // Prevent download on iOS and show modal instead
        e.preventDefault();
        iosModal.classList.remove("hidden", "opacity-0", "pointer-events-none");
        setTimeout(() => {
          iosModalContent.classList.remove("translate-y-full");
        }, 10);
      } else {
        // For Android/Desktop: Let the href="/SwitchTooEasy.apk" work naturally
        if (statusMsg) {
          statusMsg.classList.remove("hidden");
          setTimeout(() => {
            statusMsg.classList.add("hidden");
          }, 3000);
        }
      }
    });
  }

  // Close iOS Modal
  if (closeIosBtn) {
    closeIosBtn.addEventListener("click", () => {
      iosModalContent.classList.add("translate-y-full");
      setTimeout(() => {
        iosModal.classList.add("hidden", "opacity-0", "pointer-events-none");
      }, 300);
    });
  }
</script>