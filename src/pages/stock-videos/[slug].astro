---
import MainLayout from "../../layouts/MainLayout.astro";
import SeoSchemas from "../../components/SeoSchemas.astro";
import { stockVideos } from "../../data/stockVideos";

export function getStaticPaths() {
  return stockVideos.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

const pageUrl = `https://switchtooeasy.netlify.app/stock-videos/${item.slug}`;
const thumbnailUrl = `https://switchtooeasy.netlify.app${item.thumbnail}`;
const videoUrl = `https://switchtooeasy.netlify.app${item.video}`;

const relatedVideos = stockVideos
  .filter((video) => video.slug !== item.slug)
  .slice(0, 4);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: item.title,
    description: item.description,
    thumbnailUrl: [thumbnailUrl],
    contentUrl: videoUrl,
    embedUrl: pageUrl,
    uploadDate: "2026-06-09",
    publisher: {
      "@type": "Organization",
      name: "SwitchTooEasy",
      logo: {
        "@type": "ImageObject",
        url: "https://switchtooeasy.netlify.app/logo.png",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://switchtooeasy.netlify.app/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Stock Videos",
        item: "https://switchtooeasy.netlify.app/stock-videos",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: item.title,
        item: pageUrl,
      },
    ],
  },
];
---

<MainLayout
  title={`${item.title} - Download Stock Video | SwitchTooEasy`}
  description={item.shortDescription}
  canonical={pageUrl}
  image={thumbnailUrl}
  type="video.other"
>
  <SeoSchemas schemas={schemas} />

  <section class="px-4 py-14 md:px-5 md:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.2fr_.8fr]">
      <div class="flex justify-center overflow-hidden rounded-[2rem] border border-white/10 bg-black">
        <video
          src={item.video}
          poster={item.thumbnail}
          controls
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="max-h-[78vh] w-full object-contain"
        ></video>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="inline-block rounded-full bg-purple-500/20 px-4 py-2 text-sm font-semibold text-purple-200">
          {item.category}
        </p>

        <h1 class="mt-5 text-4xl font-black leading-tight md:text-5xl">
          {item.title}
        </h1>

        <p class="mt-5 text-lg leading-8 text-white/70">
          {item.description}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {item.tags.map((tag) => (
            <span class="rounded-full border border-white/10 px-4 py-2 text-sm text-white/70">
              #{tag}
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a
            href={item.downloadUrl}
            download
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-purple-500 px-8 py-4 text-center font-bold text-white hover:bg-purple-400"
          >
            Download Video
          </a>

          <a
            href="/stock-videos"
            class="rounded-full border border-white/15 px-8 py-4 text-center font-bold hover:bg-white/10"
          >
            Back
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="px-4 pb-20 md:px-5">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-black">Related Stock Videos</h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {relatedVideos.map((video) => (
          <a
            href={`/stock-videos/${video.slug}`}
            class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 hover:bg-white/10"
          >
            <video
              src={video.video}
              poster={video.thumbnail}
              muted
              autoplay
              loop
              playsinline
              preload="metadata"
              class="aspect-video w-full object-cover"
            ></video>

            <div class="p-5">
              <h3 class="font-bold">{video.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>