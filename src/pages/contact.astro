---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact SwitchTooEasy - Custom Prompts & VN Template Inquiry"
  description="Send an inquiry to SwitchTooEasy for custom AI prompts, VN templates, editing requests, collaborations and creator support."
  canonical="https://switchtooeasy.netlify.app/contact"
>
  <section class="px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-purple-300">
          Contact & Inquiry
        </p>

        <h1 class="mt-4 text-4xl font-black leading-tight md:text-6xl">
          Need a custom AI prompt or VN template?
        </h1>

        <p class="mt-6 text-lg leading-8 text-white/70">
          Send your requirement and we will review your request. You can ask for
          custom AI photo prompts, VN templates, reels editing ideas, template
          customization or collaboration.
        </p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-xl font-bold">Custom Prompts</h2>
            <p class="mt-3 text-sm leading-6 text-white/60">
              Request cinematic, couple, attitude, festival or wallpaper-style AI prompts.
            </p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-xl font-bold">VN Templates</h2>
            <p class="mt-3 text-sm leading-6 text-white/60">
              Ask for custom beat-sync, love edit, birthday, attitude or reels templates.
            </p>
          </div>
        </div>

        <div class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-bold">Contact Email</h2>
          <p class="mt-2 text-white/60">contact@switchtooeasy.com</p>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-4">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSeW6YNvm5AhpV19u8_Apw-dNdEk74loSQDMWQ22ZHUxyRNZjw/viewform?embedded=true"
          class="h-[720px] w-full rounded-[1.5rem] bg-white sm:h-[760px]"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
        >
          Loading…
        </iframe>
      </div>
    </div>
  </section>
</MainLayout>