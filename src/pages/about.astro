---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="About SwitchTooEasy - Easy Editing Templates & AI Prompts"
  description="Learn about SwitchTooEasy, a creator-focused platform for VN templates, AI image prompts and reels demo content."
  canonical="https://switchtooeasy.netlify.app/about"
>
  <section class="px-5 py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-widest text-purple-300">
        About Us
      </p>

      <h1 class="mt-4 text-4xl font-black leading-tight md:text-6xl">
        Making viral editing simple for every creator.
      </h1>

      <p class="mt-6 text-lg leading-8 text-white/70">
        SwitchTooEasy is built for creators who want professional-looking edits
        without spending hours learning complex editing tools. The platform brings
        together ready-made VN templates, detailed AI image prompts and reels-style
        demo videos in one easy-to-browse library.
      </p>

      <p class="mt-5 text-lg leading-8 text-white/70">
        Our goal is simple: help users create better Instagram reels, profile
        edits, cinematic photos, birthday videos, love edits and trending visual
        content with less confusion and faster execution.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-bold">Templates</h2>
          <p class="mt-3 text-sm leading-6 text-white/60">
            Easy VN templates for short-form video editing.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-bold">Prompts</h2>
          <p class="mt-3 text-sm leading-6 text-white/60">
            Copy-ready AI prompts for realistic image generation.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-bold">Demos</h2>
          <p class="mt-3 text-sm leading-6 text-white/60">
            Reels previews to help users choose the right edit.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>