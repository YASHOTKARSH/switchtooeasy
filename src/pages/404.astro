---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Page Not Found | SwitchTooEasy"
  description="The page you are looking for does not exist on SwitchTooEasy."
  canonical="https://switchtooeasy.netlify.app/404"
>
  <section class="flex min-h-[80vh] items-center justify-center px-5 text-center">
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-purple-300">
        404 Error
      </p>

      <h1 class="mt-4 text-6xl font-black md:text-8xl">
        Page Not Found
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-lg text-white/60">
        The page you are looking for may have been moved, deleted or does not exist.
      </p>

      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="rounded-full bg-purple-500 px-8 py-4 font-bold hover:bg-purple-400"
        >
          Back Home
        </a>

        <a
          href="/templates"
          class="rounded-full border border-white/15 px-8 py-4 font-bold hover:bg-white/10"
        >
          Browse Templates
        </a>
      </div>
    </div>
  </section>
</MainLayout>