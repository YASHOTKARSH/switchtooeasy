---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StructuredData from "../components/StructuredData.astro";
import MobileDock from "../components/MobileDock.astro"; // <-- Naya import

const {
  title = "SwitchTooEasy - Viral VN Templates & AI Image Prompts",
  description = "Discover viral VN templates, AI image prompts, reels demo videos and easy editing resources for creators.",
  canonical = "https://switchtooeasy.netlify.app/",
  image = "https://switchtooeasy.netlify.app/og-image.jpg",
  type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Basic Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07070a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.json" />

    <meta
      name="google-site-verification"
      content="T_8mC-oMM8OX0eFMmBjGgMpS7Bhvr9D-Iu57HOqQXYc"
    />
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="SwitchTooEasy" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SwitchTooEasy" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Icons / PWA -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png?v=2" />

    <!-- Structured Data -->
    <StructuredData
      type="WebSite"
      title={title}
      description={description}
      url={canonical}
      image={image}
    />
  </head>

  <!-- Added pb-20 on mobile to prevent content from hiding behind the bottom dock -->
  <body class="pb-20 md:pb-0 bg-[#07070a] text-white">
    <Header />

    <!-- Added min-h-screen so the layout doesn't break on short pages -->
    <main class="min-h-screen">
      <slot />
    </main>

    <Footer />
    
    <!-- Yeh component sirf mobile pe dikhega (md:hidden humne iske andar rakha hai) -->
    <MobileDock />

    <!-- sw.js added here  -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('ServiceWorker registration successful with scope: ', registration.scope);
            })
            .catch((err) => {
              console.log('ServiceWorker registration failed: ', err);
            });
        });
      }
    </script>
  </body>
</html>