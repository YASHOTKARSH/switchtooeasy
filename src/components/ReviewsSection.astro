---
export interface Props {
  templateName?: string;
}

const { templateName = "" } = Astro.props;
---

<!-- DYNAMIC CLIENT-SIDE REVIEWS SECTION (Lightning Fast & Non-Blocking) -->
<section class="mx-auto mt-20 max-w-7xl px-5" id="reviews-section" data-filter-template={templateName}>
  <div class="text-center">
    <span class="inline-flex items-center rounded-full bg-purple-500/15 px-3 py-1 text-xs font-semibold text-purple-300 ring-1 ring-inset ring-purple-500/30">
      Creator Testimonials
    </span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Loved by thousands of creators.
    </h2>
    <p class="mt-2 text-sm text-white/60">See what editors are saying about our VN templates.</p>
  </div>

  <!-- Loading State Placeholder -->
  <div id="reviews-loading" class="mt-12 text-center text-white/50 text-sm animate-pulse">
    Loading creator reviews...
  </div>

  <!-- Reviews Grid Container -->
  <div id="reviews-grid" class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 hidden"></div>

  <!-- Empty State -->
  <div id="reviews-empty" class="mt-12 rounded-3xl border border-white/10 bg-white/5 p-12 text-center hidden">
    <p class="text-sm text-white/60">No approved reviews yet. Be the first to leave one using the button above!</p>
  </div>
</section>

<script>
  function initReviewsSection() {
    const section = document.getElementById("reviews-section");
    if (!section || section.getAttribute("data-loaded") === "true") return;
    section.setAttribute("data-loaded", "true");

    const filterTemplate = section.getAttribute("data-filter-template") || "";
    const grid = document.getElementById("reviews-grid");
    const loading = document.getElementById("reviews-loading");
    const empty = document.getElementById("reviews-empty");
    const scriptUrl = "https://script.google.com/macros/s/AKfycbxJZLXQJFGFS0uu5TTMqXo31HMxYRRQPTOrZrUKtrKFXmRy8LBpX1nSTfMql2KG7807AA/exec";

    async function fetchReviews() {
      try {
        const res = await fetch(scriptUrl);
        const reviews = await res.json();

        loading?.classList.add("hidden");

        // Filter reviews if a specific template name was provided, or show all if empty
        const filteredReviews = filterTemplate 
          ? reviews.filter((rev: any) => rev.template && rev.template.toLowerCase() === filterTemplate.toLowerCase())
          : reviews;

        if (Array.isArray(filteredReviews) && filteredReviews.length > 0) {
          grid?.classList.remove("hidden");
          if (grid) {
            grid.innerHTML = filteredReviews.map((rev: any) => `
              <div class="flex flex-col justify-between rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all hover:border-white/20">
                <div>
                  <div class="flex items-center gap-1 text-amber-400 text-sm">
                    ${"★".repeat(Number(rev.rating) || 5)}
                  </div>
                  <p class="mt-4 text-sm leading-relaxed text-white/80">
                    "${rev.review}"
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4">
                  <div>
                    <p class="text-sm font-bold text-white">${rev.name}</p>
                    ${rev.instagram ? `<p class="text-xs text-purple-400">@${rev.instagram}</p>` : ''}
                  </div>
                  <span class="rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-medium text-white/60">
                    ${rev.template || 'Template'}
                  </span>
                </div>
              </div>
            `).join('');
          }
        } else {
          empty?.classList.remove("hidden");
        }
      } catch (err) {
        loading?.classList.add("hidden");
        empty?.classList.remove("hidden");
      }
    }

    fetchReviews();
  }

  document.addEventListener("DOMContentLoaded", initReviewsSection);
  document.addEventListener("astro:page-load", initReviewsSection);
</script>