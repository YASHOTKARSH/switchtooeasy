---
// src/components/Header.astro
---
<header
  class="sticky top-0 z-50 border-b border-white/10 bg-black/80 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-5 md:py-4"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="SwitchTooEasy Home">
      <img
        src="/logo.png"
        alt="SwitchTooEasy Logo"
        class="h-11 w-auto object-contain md:h-14"
      />
    </a>

    <!-- Desktop Nav Links (Hidden on Mobile) -->
    <div
      class="hidden items-center gap-6 text-sm font-semibold text-white/80 md:flex"
    >
      <a href="/download" class="transition hover:text-purple-300">Download App</a>
      <a href="/templates" class="transition hover:text-purple-300">Templates</a>
      <a href="/prompts" class="transition hover:text-purple-300">Prompts</a>
      <a href="/stock-images" class="transition hover:text-purple-300">Stock Images</a>
      <a href="/blog" class="transition hover:text-purple-300">Blog</a>
      <a href="/about" class="transition hover:text-purple-300">About</a>
      <a href="/contact" class="transition hover:text-purple-300">Contact</a>
    </div>

    <!-- Desktop Explore Button (Hidden on Mobile) -->
    <a
      href="/templates"
      class="hidden rounded-full bg-purple-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-purple-400 md:inline-block"
    >
      Explore
    </a>

    <!-- Mobile Menu Hamburger Button -->
    <button
      id="menuBtn"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white md:hidden transition-transform active:scale-95"
      aria-label="Open menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Dropdown Menu Drawer (Glassmorphism UI) -->
  <div
    id="mobileMenu"
    class="hidden absolute top-full left-0 w-full border-b border-white/10 bg-black/95 px-4 pb-6 pt-3 backdrop-blur-2xl md:hidden shadow-2xl transition-all duration-300 origin-top"
  >
    <div class="grid gap-2">
      <!-- Highlighted App Download -->
      <a
        href="/download"
        class="rounded-2xl px-4 py-3 font-semibold text-purple-300 bg-purple-900/20 border border-purple-500/30 hover:bg-purple-900/40 flex items-center justify-between mb-2"
      >
        <span>📱 Download App</span>
        <span class="text-xs bg-purple-500 px-2 py-0.5 rounded-full text-white">New</span>
      </a>
      
      <!-- Secondary Links (Since main ones are in Bottom Nav now) -->
      <a
        href="/stock-videos"
        class="rounded-2xl px-4 py-3 font-medium text-white/80 hover:bg-white/10 transition-colors"
      >
        Stock Videos
      </a>
      <a
        href="/stock-images"
        class="rounded-2xl px-4 py-3 font-medium text-white/80 hover:bg-white/10 transition-colors"
      >
        Stock Images
      </a>
      <a
        href="/blog"
        class="rounded-2xl px-4 py-3 font-medium text-white/80 hover:bg-white/10 transition-colors"
      >
        Blog
      </a>
      <a
        href="/about"
        class="rounded-2xl px-4 py-3 font-medium text-white/80 hover:bg-white/10 transition-colors"
      >
        About
      </a>
      <a
        href="/contact"
        class="rounded-2xl px-4 py-3 font-medium text-white/80 hover:bg-white/10 transition-colors"
      >
        Contact
      </a>

      <!-- Bottom Nav wale links yahan se hata diye hain kyunki wo screen ke neeche hamesha visible rahenge -->
    </div>
  </div>

  <script>
    const menuBtn = document.getElementById("menuBtn");
    const mobileMenu = document.getElementById("mobileMenu");

    menuBtn?.addEventListener("click", () => {
      // Toggle visibility with basic classes
      mobileMenu?.classList.toggle("hidden");
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const isClickInsideMenu = mobileMenu?.contains(event.target as Node);
      const isClickOnBtn = menuBtn?.contains(event.target as Node);
      
      if (!isClickInsideMenu && !isClickOnBtn && !mobileMenu?.classList.contains('hidden')) {
        mobileMenu?.classList.add('hidden');
      }
    });
  </script>
</header>