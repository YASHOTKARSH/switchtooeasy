---
// src/components/MobileDock.astro
const currentPath = Astro.url.pathname;
---

<nav class="fixed bottom-0 left-0 right-0 z-50 md:hidden">
  {/* Premium Glassmorphism Background */}
  <div class="absolute inset-0 bg-[#07070a]/70 backdrop-blur-lg border-t border-white/10"></div>
  
  <ul class="relative flex justify-around items-center h-20 px-2 pb-safe">
    {/* Home Tab */}
    <li>
      <a href="/" class={`flex flex-col items-center justify-center w-16 h-full space-y-1 ${currentPath === '/' ? 'text-white' : 'text-gray-500 hover:text-gray-300'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={currentPath === '/' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="text-[10px] font-medium">Home</span>
      </a>
    </li>

    {/* VN Templates Tab */}
    <li>
      <a href="/templates" class={`flex flex-col items-center justify-center w-16 h-full space-y-1 ${currentPath === '/templates' ? 'text-white' : 'text-gray-500 hover:text-gray-300'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={currentPath === '/templates' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M7 3v18"/><path d="M17 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/>
        </svg>
        <span class="text-[10px] font-medium">Templates</span>
      </a>
    </li>

    {/* AI Prompts Tab (Sparkles icon for AI) */}
    <li>
      <a href="/prompts" class={`flex flex-col items-center justify-center w-16 h-full space-y-1 ${currentPath === '/prompts' ? 'text-white' : 'text-gray-500 hover:text-gray-300'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={currentPath === '/prompts' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
        <span class="text-[10px] font-medium">AI Prompts</span>
      </a>
    </li>
  </ul>
</nav>