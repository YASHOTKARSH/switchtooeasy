---
const { prompt } = Astro.props;
---

<article class="group overflow-hidden rounded-3xl border border-white/10 bg-white/5 transition hover:-translate-y-1 hover:bg-white/10">
  <a href={`/prompts/${prompt.slug}`}>
    <img
      src={prompt.image}
      alt={prompt.title}
      class="h-64 w-full object-cover"
      loading="lazy"
    />

    <div class="p-6">
      <p class="mb-3 inline-block rounded-full bg-pink-500/20 px-3 py-1 text-xs font-semibold text-pink-200">
        {prompt.category}
      </p>

      <h2 class="text-xl font-bold group-hover:text-pink-300">
        {prompt.title}
      </h2>

      <p class="mt-3 text-sm leading-6 text-white/60">
        {prompt.shortDescription}
      </p>

      <span class="mt-5 inline-block text-sm font-bold text-pink-300">
        View Prompt →
      </span>
    </div>
  </a>
</article>