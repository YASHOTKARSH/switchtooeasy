---
const { template } = Astro.props;
---

<a
  href={`/templates/${template.slug}`}
  class="group relative block overflow-hidden rounded-[2rem] border border-white/10 bg-black"
>
  <!-- Loading Skeleton -->
  <div class="absolute inset-0 animate-pulse bg-white/5"></div>

  <!-- Video -->
<video
  src={template.video}
  poster={template.image}
  muted
  loop
  autoplay
  playsinline
  preload="metadata"
  class="relative aspect-[9/16] w-full object-cover transition duration-500 group-hover:scale-105"
  onloadeddata="this.previousElementSibling.style.display='none'"
></video>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

  <!-- Content -->
  <div class="absolute bottom-0 left-0 z-10 w-full p-5">
    <span class="inline-block rounded-full bg-purple-500/20 px-3 py-1 text-xs font-semibold text-purple-200 backdrop-blur">
      {template.category}
    </span>

    <h2 class="mt-3 text-xl font-bold leading-tight text-white">
      {template.title}
    </h2>

    <p class="mt-2 line-clamp-2 text-sm text-white/70">
      {template.shortDescription}
    </p>
  </div>
</a>