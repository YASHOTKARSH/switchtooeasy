---
export interface Props {
  template?: string;
}

const { template = "Homepage" } = Astro.props;
const scriptUrl = "https://script.google.com/macros/s/AKfycbxJZLXQJFGFS0uu5TTMqXo31HMxYRRQPTOrZrUKtrKFXmRy8LBpX1nSTfMql2KG7807AA/exec";
---

<div class="review-widget-wrapper" data-template={template} data-script-url={scriptUrl}>
  <!-- TRIGGER BUTTON -->
  <button
    type="button"
    class="open-review-modal group relative inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/10 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-purple-950/20 backdrop-blur-xl transition-all duration-300 hover:border-purple-500/50 hover:bg-white/15 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-black active:scale-95 cursor-pointer"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <span class="text-amber-400 transition-transform duration-300 group-hover:rotate-12" aria-hidden="true">⭐</span>
    <span>Leave a Review</span>
  </button>

  <!-- MODAL OVERLAY -->
  <div
    class="review-modal fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300 ease-out"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <!-- BACKDROP -->
    <div
      class="review-backdrop absolute inset-0 bg-black/80 backdrop-blur-md transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <!-- MODAL CONTENT CONTAINER -->
    <div
      class="review-dialog-content relative w-full max-w-lg transform scale-95 opacity-0 rounded-[32px] border border-white/15 bg-neutral-950/90 p-6 sm:p-8 text-white shadow-2xl shadow-purple-950/40 backdrop-blur-2xl transition-all duration-300 ease-out max-h-[90vh] overflow-y-auto scrollbar-none"
    >
      <!-- CLOSE BUTTON -->
      <button
        type="button"
        class="close-review-modal absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/70 transition-all hover:bg-white/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-purple-400 cursor-pointer"
        aria-label="Close modal"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- VIEW 1: FORM VIEW -->
      <div class="review-form-view space-y-6">
        <div>
          <span class="inline-flex items-center rounded-full bg-purple-500/15 px-3 py-1 text-xs font-semibold text-purple-300 ring-1 ring-inset ring-purple-500/30">
            Feedback &bull; {template}
          </span>
          <h2 class="mt-3 text-2xl font-black tracking-tight sm:text-3xl">
            Love using this template?
          </h2>
          <p class="mt-2 text-sm text-white/60">
            Your feedback helps us improve SwitchTooEasy for every creator.
          </p>
        </div>

        <form class="review-form space-y-5" novalidate>
          <div class="hidden" aria-hidden="true">
            <label>Website</label>
            <input type="text" class="website-hp" tabindex="-1" autocomplete="off" />
          </div>

          <!-- RATING COMPONENT -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-white/70 mb-2">
              Rating <span class="text-purple-400">*</span>
            </label>
            <div class="star-rating-group flex items-center gap-2" role="radiogroup" aria-label="Rating">
              {[1, 2, 3, 4, 5].map((star) => (
                <button
                  type="button"
                  data-value={star}
                  role="radio"
                  aria-checked="false"
                  aria-label={`${star} Star`}
                  class="star-btn group/star relative p-1 text-2xl sm:text-3xl transition-transform hover:scale-125 focus:outline-none focus:ring-2 focus:ring-purple-400 rounded-lg cursor-pointer"
                >
                  <span class="star-icon text-white/20 transition-colors duration-200 group-hover/star:text-amber-400">★</span>
                </button>
              ))}
            </div>
            <input type="hidden" class="rating-input" required />
            <p class="rating-error mt-1.5 text-xs text-rose-400 hidden">Please select a rating score.</p>
          </div>

          <!-- NAME FIELD -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-white/70 mb-1.5">
              Your Name <span class="text-purple-400">*</span>
            </label>
            <input
              type="text"
              class="reviewer-name w-full rounded-2xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/40 transition-colors focus:border-purple-500 focus:bg-white/10 focus:outline-none"
              required
              maxlength="50"
              placeholder="e.g. Alex Creator"
            />
            <p class="name-error mt-1.5 text-xs text-rose-400 hidden">Please enter your name.</p>
          </div>

          <!-- INSTAGRAM USERNAME -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-white/70 mb-1.5">
              Instagram Username <span class="text-white/40 font-normal">(Optional)</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-white/40 text-sm">@</span>
              <input
                type="text"
                class="reviewer-insta w-full rounded-2xl border border-white/15 bg-white/5 py-3 pl-8 pr-4 text-sm text-white placeholder-white/40 transition-colors focus:border-purple-500 focus:bg-white/10 focus:outline-none"
                maxlength="30"
                placeholder="username"
              />
            </div>
          </div>

          <!-- REVIEW TEXTAREA -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-white/70">
                Your Review <span class="text-purple-400">*</span>
              </label>
              <span class="char-count text-xs text-white/40 font-mono">0 / 500</span>
            </div>
            <textarea
              class="reviewer-text w-full rounded-2xl border border-white/15 bg-white/5 p-4 text-sm text-white placeholder-white/40 transition-colors focus:border-purple-500 focus:bg-white/10 focus:outline-none resize-none"
              required
              rows="4"
              minlength="20"
              maxlength="500"
              placeholder="Tell us what you loved about this template (min 20 characters)..."
            ></textarea>
            
            <div class="mt-2 flex items-center justify-between gap-4">
              <div class="h-1.5 flex-1 rounded-full bg-white/10 overflow-hidden">
                <div class="char-progress h-full w-0 bg-purple-500 transition-all duration-200"></div>
              </div>
              <span class="reading-time text-[11px] text-white/40 whitespace-nowrap">0s read</span>
            </div>
            <p class="review-error mt-1.5 text-xs text-rose-400 hidden">Review must be between 20 and 500 characters.</p>
          </div>

          <!-- SUBMIT BUTTON -->
          <button
            type="submit"
            class="submit-review-btn group relative w-full flex items-center justify-center rounded-2xl bg-gradient-to-r from-purple-600 to-pink-600 py-4 text-sm font-bold text-white shadow-lg shadow-purple-600/30 transition-all duration-300 hover:opacity-95 hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 focus:ring-offset-black disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.99] cursor-pointer"
          >
            <span class="btn-text flex items-center gap-2">
              <span>Submit Review</span>
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </span>
            <span class="btn-loader hidden flex items-center gap-2">
              <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Submitting to Cloud...</span>
            </span>
          </button>
        </form>
      </div>

      <!-- SUCCESS STATE -->
      <div class="review-success-view hidden py-8 text-center space-y-6">
        <div class="relative mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/30 animate-bounce">
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-3xl font-black text-white">Thank You ❤️</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70 max-w-sm mx-auto">
            Your review has been submitted successfully! Once approved by admin, it will appear publicly on the site.
          </p>
        </div>
        <button
          type="button"
          class="success-close-btn inline-flex w-full items-center justify-center rounded-2xl bg-white/10 py-4 text-sm font-bold text-white transition-all hover:bg-white/20 cursor-pointer"
        >
          Close Window
        </button>
      </div>

      <!-- ERROR STATE -->
      <div class="review-error-view hidden py-8 text-center space-y-6">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30">
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-2xl font-black text-white">Submission Failed</h3>
          <p class="error-message-text mt-2 text-sm text-white/60 max-w-sm mx-auto">
            Something went wrong. Please check your connection and try again.
          </p>
        </div>
        <div class="flex gap-3">
          <button type="button" class="retry-review-btn flex-1 rounded-2xl bg-purple-600 py-3.5 text-sm font-bold text-white cursor-pointer">Try Again</button>
          <button type="button" class="error-close-btn flex-1 rounded-2xl bg-white/10 py-3.5 text-sm font-bold text-white cursor-pointer">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initReviewWidgets() {
    const wrappers = document.querySelectorAll(".review-widget-wrapper");

    wrappers.forEach((wrapper) => {
      if (wrapper.getAttribute("data-initialized") === "true") return;
      wrapper.setAttribute("data-initialized", "true");

      const templateName = wrapper.getAttribute("data-template") || "Homepage";
      const scriptUrl = wrapper.getAttribute("data-script-url") || "";

      const openBtn = wrapper.querySelector(".open-review-modal") as HTMLButtonElement;
      const closeBtn = wrapper.querySelector(".close-review-modal") as HTMLButtonElement;
      const successCloseBtn = wrapper.querySelector(".success-close-btn") as HTMLButtonElement;
      const errorCloseBtn = wrapper.querySelector(".error-close-btn") as HTMLButtonElement;
      const retryBtn = wrapper.querySelector(".retry-review-btn") as HTMLButtonElement;
      
      const modal = wrapper.querySelector(".review-modal") as HTMLElement;
      const dialogContent = wrapper.querySelector(".review-dialog-content") as HTMLElement;
      const backdrop = wrapper.querySelector(".review-backdrop") as HTMLElement;

      const formView = wrapper.querySelector(".review-form-view") as HTMLElement;
      const successView = wrapper.querySelector(".review-success-view") as HTMLElement;
      const errorView = wrapper.querySelector(".review-error-view") as HTMLElement;
      const errorMessageText = wrapper.querySelector(".error-message-text") as HTMLElement;

      const form = wrapper.querySelector(".review-form") as HTMLFormElement;
      const starBtns = wrapper.querySelectorAll(".star-btn");
      const ratingInput = wrapper.querySelector(".rating-input") as HTMLInputElement;
      const ratingError = wrapper.querySelector(".rating-error") as HTMLElement;
      
      const nameInput = wrapper.querySelector(".reviewer-name") as HTMLInputElement;
      const nameError = wrapper.querySelector(".name-error") as HTMLElement;
      const instaInput = wrapper.querySelector(".reviewer-insta") as HTMLInputElement;
      const reviewTextarea = wrapper.querySelector(".reviewer-text") as HTMLTextAreaElement;
      const reviewError = wrapper.querySelector(".review-error") as HTMLElement;
      const charCount = wrapper.querySelector(".char-count") as HTMLElement;
      const charProgress = wrapper.querySelector(".char-progress") as HTMLElement;
      const readingTime = wrapper.querySelector(".reading-time") as HTMLElement;

      const submitBtn = wrapper.querySelector(".submit-review-btn") as HTMLButtonElement;
      const btnText = wrapper.querySelector(".btn-text") as HTMLElement;
      const btnLoader = wrapper.querySelector(".btn-loader") as HTMLElement;
      const hpInput = wrapper.querySelector(".website-hp") as HTMLInputElement;

      let selectedRating = 0;
      let userIp = "Unknown";

      // Fetch Client IP automatically
      fetch("https://api.ipify.org?format=json")
        .then(res => res.json())
        .then(data => { userIp = data.ip; })
        .catch(() => {});

      function openModal() {
        if (!modal || !dialogContent) return;
        modal.classList.remove("opacity-0", "pointer-events-none");
        dialogContent.classList.remove("scale-95", "opacity-0");
        dialogContent.classList.add("scale-100", "opacity-100");
        document.body.style.overflow = "hidden";
        openBtn?.setAttribute("aria-expanded", "true");
        nameInput?.focus();
      }

      function closeModal() {
        if (!modal || !dialogContent) return;
        modal.classList.add("opacity-0", "pointer-events-none");
        dialogContent.classList.remove("scale-100", "opacity-100");
        dialogContent.classList.add("scale-95", "opacity-0");
        document.body.style.overflow = "";
        openBtn?.setAttribute("aria-expanded", "false");
      }

      openBtn?.addEventListener("click", openModal);
      closeBtn?.addEventListener("click", closeModal);
      backdrop?.addEventListener("click", closeModal);
      successCloseBtn?.addEventListener("click", closeModal);
      errorCloseBtn?.addEventListener("click", closeModal);
      retryBtn?.addEventListener("click", () => {
        errorView?.classList.add("hidden");
        formView?.classList.remove("hidden");
      });

      function setRating(val: number) {
        selectedRating = val;
        if (ratingInput) ratingInput.value = val.toString();
        ratingError?.classList.add("hidden");

        starBtns.forEach((btn, idx) => {
          const icon = btn.querySelector(".star-icon");
          if (idx < val) {
            icon?.classList.remove("text-white/20");
            icon?.classList.add("text-amber-400");
          } else {
            icon?.classList.add("text-white/20");
            icon?.classList.remove("text-amber-400");
          }
        });
      }

      starBtns.forEach((btn) => {
        const val = parseInt(btn.getAttribute("data-value") || "0", 10);
        btn.addEventListener("click", () => setRating(val));
      });

      reviewTextarea?.addEventListener("input", () => {
        const len = reviewTextarea.value.length;
        if (charCount) charCount.textContent = `${len} / 500`;
        if (charProgress) charProgress.style.width = `${Math.min(100, (len / 500) * 100)}%`;
        if (len >= 20) reviewError?.classList.add("hidden");
      });

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (hpInput && hpInput.value.trim() !== "") return;

        let isValid = true;
        if (!selectedRating) { ratingError?.classList.remove("hidden"); isValid = false; }
        if (!nameInput?.value.trim()) { nameError?.classList.remove("hidden"); isValid = false; }
        if ((reviewTextarea?.value.trim().length || 0) < 20) { reviewError?.classList.remove("hidden"); isValid = false; }
        if (!isValid) return;

        const payload = {
          name: nameInput.value.trim(),
          instagram: instaInput?.value.trim().replace(/^@/, "") || "",
          rating: selectedRating,
          template: templateName,
          review: reviewTextarea.value.trim(),
          ip: userIp
        };

        submitBtn.setAttribute("disabled", "true");
        btnText?.classList.add("hidden");
        btnLoader?.classList.remove("hidden");

        try {
          await fetch(scriptUrl, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          form.reset();
          selectedRating = 0;
          starBtns.forEach((b) => b.querySelector(".star-icon")?.classList.add("text-white/20"));
          starBtns.forEach((b) => b.querySelector(".star-icon")?.classList.remove("text-amber-400"));

          formView?.classList.add("hidden");
          successView?.classList.remove("hidden");
        } catch (err: any) {
          if (errorMessageText) errorMessageText.textContent = err.message || "Failed to submit.";
          formView?.classList.add("hidden");
          errorView?.classList.remove("hidden");
        } finally {
          submitBtn.removeAttribute("disabled");
          btnText?.classList.remove("hidden");
          btnLoader?.classList.add("hidden");
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initReviewWidgets);
  document.addEventListener("astro:page-load", initReviewWidgets);
</script>